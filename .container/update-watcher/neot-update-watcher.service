[Unit]
Description=Verify and deploy a NEOT production update
Documentation=file:///home/neot/assist/deploy.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=NEOT_WATCHER_REPO_DIR=/home/neot
ExecStart=/usr/local/sbin/neot-update-watcher
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/neot /root/.docker /var/lib/neot-update-watcher /var/tmp /run/lock
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1h

[Install]
WantedBy=multi-user.target
