# This file is read only by .container/local-ai/docker-compose.yml.
# Copy it to .container/local-ai/.env through setup-local-ai.ps1 -Apply, then adjust it.

# Services bind to loopback only. Do not expose them to your network by default.
LOCAL_AI_OLLAMA_PORT=11434
LOCAL_AI_QDRANT_HTTP_PORT=6333
LOCAL_AI_QDRANT_GRPC_PORT=6334

# Default model is a practical balance for local development machines. Use
# qwen2.5-coder:0.5b for a minimal smoke test, or qwen2.5-coder:7b after
# checking local memory and download capacity.
LOCAL_AI_CHAT_MODEL=qwen2.5-coder:3b
LOCAL_AI_EMBEDDING_MODEL=nomic-embed-text

# Set explicit absolute paths when Docker Desktop cannot resolve the defaults.
# LOCAL_AI_OLLAMA_DATA_DIR=E:/NEOT/storage/local-ai/ollama
# LOCAL_AI_QDRANT_DATA_DIR=E:/NEOT/storage/local-ai/qdrant

# Pin image tags here for a repeatable production-like local environment.
OLLAMA_IMAGE=ollama/ollama:latest
QDRANT_IMAGE=qdrant/qdrant:latest
