# NEOT production runtime
NODE_ENV=production
AUTH_MODE=jwt
DEV_AUTO_LOGIN=0

# NEOT Platform API and Web
PLATFORM_API_PORT=9250
PLATFORM_API_URL=http://127.0.0.1:9250
PLATFORM_WEB_PORT=9260
PLATFORM_WEB_ORIGIN=http://127.0.0.1:9260
PLATFORM_WEB_ORIGINS=
PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:9260/status
VITE_PLATFORM_API_URL=http://127.0.0.1:9250
VITE_DEV_AUTO_LOGIN=0

# Setup synchronizes DB_USER, DB_PASSWORD, and DB_NAME from deploy.env.
DB_DRIVER=mariadb
DB_HOST=cxapp-mariadb
DB_PORT=3306
DB_USER=neot
DB_PASSWORD=generate-with-setup
DB_NAME=neot_db

# Setup fills these values when shared CXApp infrastructure is selected.
REDIS_URL=
NEOT_STORAGE_PATH=/var/lib/neot/media/neot
FILE_MANAGER_LOCAL_ROOT=/var/lib/neot/media/neot/file-manager

# Authentication and protected administrator
JWT_SECRET=generate-with-setup
INITIAL_ADMIN_NAME=NEOT Administrator
INITIAL_ADMIN_EMAIL=admin@neot.local
INITIAL_ADMIN_PASSWORD=

# Agent IDE model gateway. Keep the API key server-side.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
CODEX_EXECUTABLE=bundled

# Telegram support. TELEGRAM_WEBHOOK_PUBLIC_URL must be public HTTPS.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret
TELEGRAM_WEBHOOK_PUBLIC_URL=



# Destructive database reset remains disabled
NEOT_DB_FRESH_ON_START=0
NEOT_DB_RESET_CONFIRM=
NEOT_ALLOW_PRODUCTION_DB_RESET=0
