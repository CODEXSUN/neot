# Docker project and images
NEOT_COMPOSE_PROJECT=neot
NEOT_IMAGE_REGISTRY=neot
NEOT_VERSION=1.0.21
NEOT_IMAGE_TAG=1.0.21
NEOT_MIGRATION_COMPATIBLE_VERSION=1.0.21
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.2
NEOT_BACKUP_RETENTION=10
NEOT_UPDATE_MIN_BACKUP_FREE_MB=1024
NEOT_UPDATE_MIN_DOCKER_FREE_MB=5120

# Docker resources
NEOT_API_CONTAINER_NAME=neot-api
NEOT_WEB_CONTAINER_NAME=neot-web
NEOT_MARIADB_CONTAINER_NAME=neot-mariadb
NEOT_NETWORK=cxapp-network
NEOT_NETWORK_EXTERNAL=true
NEOT_MARIADB_DATA_VOLUME=neot-mariadb-data
NEOT_CODEX_STATE_VOLUME=neot-codex-state
NEOT_AGENT_WORKTREE_VOLUME=neot-agent-worktrees
NEOT_AGENT_REPOSITORY_VOLUME=neot-agent-repositories
NEOT_MEDIA_DATA_VOLUME=neot-media-data
NEOT_MEDIA_DATA_VOLUME_EXTERNAL=false

# Loopback publishing
NEOT_BIND_ADDRESS=127.0.0.1
NEOT_API_INTERNAL_PORT=9250
NEOT_API_HOST_PORT=9250
NEOT_WEB_HOST_PORT=9260

# Telegram support runtime values are copied to the root .env used by the API.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret
TELEGRAM_WEBHOOK_PUBLIC_URL=

# Standalone MariaDB infrastructure
MARIADB_IMAGE=mariadb:11.8
MARIADB_ROOT_PASSWORD=generate-with-setup
DB_USER=neot
DB_PASSWORD=generate-with-setup
DB_NAME=neot_db

# Reuse CXApp-owned MariaDB infrastructure while keeping the NEOT database separate.
NEOT_SHARED_MARIADB_CONTAINER_NAME=cxapp-mariadb
NEOT_SHARED_MARIADB_ENV_FILE=../../cxapp/.container/deploy.env
NEOT_SHARED_MARIADB_ROOT_PASSWORD=
NEOT_SHARED_REDIS_CONTAINER_NAME=cxapp-redis
NEOT_SHARED_MEDIA_CONTAINER_NAME=cxapp-media
