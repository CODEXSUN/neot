# Runtime
NODE_ENV=development
AUTH_MODE=jwt
DEV_AUTO_LOGIN=0
API_ROUTE_LOGGING=0

# NEOT Platform API and Web
PLATFORM_API_PORT=9250
PLATFORM_API_URL=http://127.0.0.1:9250
PLATFORM_WEB_PORT=9260
PLATFORM_WEB_ORIGIN=http://127.0.0.1:9260
PLATFORM_WEB_ORIGINS=http://localhost
PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:9260/status
VITE_PLATFORM_API_URL=http://127.0.0.1:9250
VITE_PLATFORM_WEB_URL=http://127.0.0.1:9260
VITE_MOBILE_API_URL=http://10.0.2.2:9250
VITE_DEV_AUTO_LOGIN=0

# Local development database.
# Container setup replaces these three values in .container/.env from deploy.env.
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=neot
DB_PASSWORD=
DB_NAME=neot_db

# Authentication and protected administrator
JWT_SECRET=
NEOT_MODEL_PROVIDER_ENCRYPTION_KEY=

# Optional OpenCode coding-runtime bridge. The bundled OpenCode CLI can serve this endpoint.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@neot.local
INITIAL_ADMIN_PASSWORD=


# NEOT-owned local integrations and storage.
NEOT_WORKSPACE_ROOT=..
NEOT_STORAGE_PATH=./storage/neot
FILE_MANAGER_LOCAL_ROOT=./storage/neot/file-manager
NEOT_SYNC_ROLE=local
NEOT_SYNC_INSTANCE_ID=local-neot
NEOT_SYNC_ENCRYPTION_KEY=
NEOT_SYNC_TOKEN_PEPPER=
# Online neot.in runs with NEOT_SYNC_ROLE=cloud. Local installations remain local.

# Agent IDE model gateway. Keep the API key server-side.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
CODEX_EXECUTABLE=bundled
# Optional local-AI services. These values do not replace the Codex runtime.
# Run `npm run local-ai:setup`, review its plan, then rerun with `-Apply` to create
# local Ollama and Qdrant services. Qdrant is for future semantic retrieval;
# MariaDB remains the product metadata and transaction store.
NEOT_LOCAL_AI_ENABLED=0
NEOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEOT_OLLAMA_CHAT_MODEL=qwen2.5-coder:3b
NEOT_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
NEOT_QDRANT_URL=http://127.0.0.1:6333
NEOT_QDRANT_COLLECTION=neot_project_context
# Primary Codex authentication store. The secondary connector uses connections/secondary below it.
# Docker fixes this root to /var/lib/neot/codex.
NEOT_CODEX_HOME=
# Writable Agent IDE runs use isolated Git worktrees. Docker fixes this to /srv/neot/repositories.
NEOT_AGENT_ALLOWED_ROOTS=
# Docker fixes this to /var/lib/neot/worktrees.
NEOT_AGENT_WORKTREE_ROOT=
# JSON array of shell-free quality gate commands. The built-in default runs git diff --check.
NEOT_AGENT_VERIFICATION_COMMANDS=
# Local commit identity. Agent commits are never pushed automatically.
NEOT_AGENT_GIT_NAME=NEOT
NEOT_AGENT_GIT_EMAIL=neot@localhost

# Telegram support bot. Create the bot with @BotFather. Keep the token server-side.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PUBLIC_URL=

# Notification delivery. MariaDB remains the queue authority when Redis is unavailable.
REDIS_URL=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=0
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=NEOT

# Container deployment overrides this with the mounted root .env path.
NEOT_ENV_FILE_PATH=

# Destructive database reset remains disabled
NEOT_DB_FRESH_ON_START=0
NEOT_DB_RESET_CONFIRM=
NEOT_ALLOW_PRODUCTION_DB_RESET=0
NEOT_OPENCODE_PATH=
